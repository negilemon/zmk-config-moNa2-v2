#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 2 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        my_comma_bang: my_comma_bang {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_COMMA_BANG";
            bindings = <&kp COMMA>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        my_dot_question: my_dot_question {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_DOT_QUESTION";
            bindings = <&kp PERIOD>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        my_bs_del: my_bs_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_BS_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        my_shot: my_shot {
            compatible = "zmk,behavior-mod-morph";
            label = "MY_SHOT";
            bindings = <&kp LG(LS(LC(NUMBER_4)))>, <&kp LG(LS(NUMBER_4))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W      &kp E         &kp R       &kp T                                                                     &kp Y        &kp U    &kp I           &kp O             &kp P
&kp A             &kp S      &kp D         &kp F       &kp G                                       &my_shot                      &kp H        &kp J    &kp K           &kp L             &lt 2 SEMICOLON
&mt LEFT_SHIFT Z  &kp X      &kp C         &kp V       &kp B        &kp TAB                        &none                         &kp N        &lt 3 M  &my_comma_bang  &my_dot_question  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN      &kp LCTRL  &kp LEFT_ALT  &my_bs_del  &lt 1 SPACE  &lt_to_layer_0 2 LANGUAGE_2    &mt RIGHT_COMMAND LANGUAGE_1  &lt 4 ENTER                                             &lt 5 ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS                     &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &trans
&trans        &kt NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS            &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT        &trans
&trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans     &trans    &trans  &trans  &kp LESS_THAN         &kp GREATER_THAN       &kp GRAVE      &trans
&trans        &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans          &kp C_BRI_DEC      &kp C_BRI_UP     &trans                    &trans             &kp LC(LEFT_ARROW)  &kp F3            &kp LC(RIGHT_ARROW)  &trans
&trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT       &trans            &trans  &kp C_VOL_UP       &mkp MB1            &mkp MB3          &mkp MB2             &trans
&trans  &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &trans    &trans  &kp C_VOLUME_DOWN  &mkp MB4            &kp C_PLAY_PAUSE  &mkp MB5             &trans
&trans  &trans          &trans             &trans           &trans  &trans    &trans  &trans                                                                        &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &kp RC(TAB)             &kp UP_ARROW          &kp RC(RS(TAB))          &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &kp LEFT_ARROW          &kp DOWN_ARROW        &kp RIGHT_ARROW          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LG(LC(LEFT_ARROW))  &kp LG(LC(UP_ARROW))  &kp LG(LC(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
